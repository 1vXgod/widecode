# Copy to .env.local and fill in values. Never commit real .env files.

# Public, canonical URL of the site (no trailing slash), e.g. https://example.com
# Leave empty until the production domain is decided. Locally the site falls back
# to http://localhost:3000; on Vercel it falls back to the production deployment URL.
NEXT_PUBLIC_SITE_URL=

# Quote form delivery via Resend (https://resend.com). Server-only: never prefix
# these with NEXT_PUBLIC_. Until all three are set, `next dev` only prints
# requests to the server console (visitors are told the request was not sent)
# and production shows a "temporarily unavailable" message instead of the form.
# See "Quote form delivery" in the README.
RESEND_API_KEY=
# Where quote requests are delivered (one address, or up to 5 comma-separated).
QUOTE_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. WideCode <ofertat@your-domain>
QUOTE_FROM_EMAIL=

# Optional developer aid: "log" validates and prints requests instead of sending
# them. Not allowed on a Vercel production deployment.
QUOTE_DELIVERY=
# RESEND_API_URL is for automated tests only (loopback addresses); leave it unset.
